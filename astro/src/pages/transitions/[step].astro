---
import type { GetStaticPaths } from 'astro';
import Counter from '../../components/Counter';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = (() =>
  ['1', '2', '3'].map((step) => ({
    params: { step },
  }))) satisfies GetStaticPaths;

const step = Number(Astro.params.step);
---

<Base title={`Step ${step}`} clientRouter>
  <h1>Step {step} of 3</h1>
  <p>
    <code>&lt;ClientRouter /&gt;</code> swaps pages without a full reload. Count
    up on both buttons, then move to another step.
  </p>
  <Counter client:load transition:persist label="Persisted" />
  <Counter client:load label="Not persisted" />
  <nav>
    {step > 1 && <a href={`/transitions/${step - 1}`}>Previous</a>}
    {step < 3 && <a href={`/transitions/${step + 1}`}>Next</a>}
  </nav>
</Base>
