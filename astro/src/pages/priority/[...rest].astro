---
import Base from '../../layouts/Base.astro';

export const prerender = false;

const { rest } = Astro.params;
---

<Base title="Priority: rest parameter">
  <h1>Rendered by priority/[...rest].astro</h1>
  <p>
    <code>rest</code> is <code>{rest ?? 'undefined'}</code>. Only a rest
    parameter can match more than one segment.
  </p>
</Base>
