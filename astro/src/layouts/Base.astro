---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  // Only the /transitions pages opt into client-side navigation.
  clientRouter?: boolean;
}

const {
  title,
  description = 'Runnable reference for file-based routing in Astro',
  clientRouter = false,
} = Astro.props;
---

<!doctype html>
<html lang={Astro.currentLocale ?? 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · Routing Showcase</title>
    {clientRouter && <ClientRouter />}
  </head>
  <body>
    <main>
      {Astro.url.pathname !== '/' && (
        <p class="back">
          <a href="/">Home</a>
        </p>
      )}
      <slot />
    </main>
  </body>
</html>
